# Line endings are normalised to LF in the repository and checked out native.
# Two collaborators work on Windows and markdown has twice been flattened in
# transit; declaring the text types here stops a CRLF round-trip from showing as
# a whole-file diff and hiding the real change.
* text=auto eol=lf

*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.toml text eol=lf
*.csv  text eol=lf

# Evidence and derived artifacts are byte-exact. A CSV whose SHA-256 is recorded
# in a manifest must never be rewritten by a line-ending filter: that changes the
# hash and breaks the integrity check the manifest exists to support.
groundtruth/*-sha256.csv            -text
groundtruth/*-sha256-supplement.csv -text
docs/evidence/**                    -text
# The viewer's sample runs are sealed by manifest.sha256 (run.json, CSVs,
# report.html): byte-exact for the same reason. Verified 2026-09-26 that every
# committed blob still matches its manifest; this keeps it that way.
viewer/samples/**                   -text

# Binary evidence, should any ever be committed deliberately.
*.pf    binary
*.evtx  binary
*.hve   binary
*.vhdx  binary
# Windows batch files must keep CRLF: cmd.exe mis-parses goto labels in LF files.
*.bat text eol=crlf

# GitHub language statistics (Linguist). The sample runs and test fixtures are
# pipeline OUTPUT (report.html alone is ~1 MB) and the MODA*-G core is
# third-party code; counting them made the repo read as 45% HTML. Marking them
# changes only the language bar, never the files.
viewer/samples/**          linguist-generated
viewer/tests/fixtures/**   linguist-generated
dfir_triage_pipeline/_vendor/** linguist-vendored
