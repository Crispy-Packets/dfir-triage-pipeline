.venv/
__pycache__/
*.egg-info/
*.pyc
.pytest_cache/
.ruff_cache/

# Evidence and derived output never enter git
collections/
outputs/
*.evtx
*.pf
*.vhdx
*.hve
*.csv
!tests/fixtures/**/*.csv
!groundtruth/*.csv

# tools/ holds collection binaries (KAPE) which never enter git, but the
# analysis scripts cited by docs/ and groundtruth/ must be tracked: their
# outputs are on the record, so the instrument that produced them has to be too.
tools/*
!tools/*.py

# Analysis-tool output: regenerable, machine-written, not part of the deliverable
graphify-out/
.graphify_python
repomix-output.*
repomix.config.json
.repomixignore
