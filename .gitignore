.venv/
__pycache__/
*.egg-info/
*.pyc
.pytest_cache/
.ruff_cache/

# Evidence and derived output never enter git
collections/
outputs/
*.evtx
*.pf
*.vhdx
*.hve
*.csv
!tests/fixtures/**/*.csv
!groundtruth/*.csv
# viewer/ (Person A's read-only Streamlit viewer). Its sample runs and test
# fixtures are sealed by manifest.sha256, which covers the CSVs -- untracked
# CSVs would make every sample fail verification after a clone. A deliberate
# exception to "derived output never enters git": the viewer cannot run or
# test without them. Lab-VM data only; the repository is private.
!viewer/samples/**/*.csv
!viewer/tests/fixtures/**/*.csv

# tools/ holds collection binaries (KAPE) which never enter git, but the
# analysis scripts cited by docs/ and groundtruth/ must be tracked: their
# outputs are on the record, so the instrument that produced them has to be too.
tools/*
!tools/*.py
!tools/*.ps1

# Analysis-tool output: regenerable, machine-written, not part of the deliverable
graphify-out/
.graphify_python
repomix-output.*
repomix.config.json
.repomixignore

# live-run scratch output at repo root (derived; run.json is regenerated per run)
/run*.json
/report.html
/manifest.sha256
/narration_*.json
